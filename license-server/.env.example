# Clave privada de licencias (la de tools/keys/private.pem). Obtén el valor en una sola línea con:
#   npm run license:export-key     (desde la carpeta principal del CRM)
LICENSE_PRIVATE_KEY=
# Credenciales de tu app de PayPal (developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox para pruebas, live para cobrar de verdad
PAYPAL_MODE=sandbox
# URL pública de este servidor, sin barra final
PUBLIC_URL=https://licencias.tudominio.com
CURRENCY=USD
# Opcional: precios propios
# PRICES_JSON={"starter":{"month":15,"year":149},"pro":{"month":39,"year":390},"business":{"month":89,"year":890}}
# Base de datos de suscripciones (mejor fuera de la carpeta de la app)
DB_FILE=./data/licenses.db
# Token para consultar /admin/subscriptions
ADMIN_TOKEN=
TRUST_PROXY=true
BRAND_NAME=NexoCRM
