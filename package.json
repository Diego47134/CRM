{
  "name": "nexocrm",
  "version": "1.0.0",
  "description": "NexoCRM - CRM completo autoalojado con licencia anual",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "license:keygen": "node --disable-warning=ExperimentalWarning tools/license.js keygen",
    "license:issue": "node --disable-warning=ExperimentalWarning tools/license.js issue",
    "license:inspect": "node --disable-warning=ExperimentalWarning tools/license.js inspect"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
