# Puerto HTTP
PORT=3000
# Ruta de la base de datos SQLite
DB_FILE=./data/crm.db
# "true" si está detrás de un proxy inverso (para registrar la IP real)
TRUST_PROXY=false
# Opcional: secreto JWT fijo (si no, se genera y guarda en la base de datos)
# JWT_SECRET=
# Opcional: ruta alternativa a la clave pública de licencias
# LICENSE_PUBLIC_KEY_FILE=./server/license-public.pem
